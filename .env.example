# KubeIntellect — SHARED INFRASTRUCTURE config (root)
#
# This file configures the shared Kind cluster + observability stack used by ALL
# versions. Per-version app config lives in vN/.env (copy vN/.env.example there).
#
#   cp .env.example .env
#   make langfuse-provision     # fills in the LANGFUSE_* keys below + fans them to v*/.env
#
# ── Cluster ───────────────────────────────────────────────────────────────────
KIND_CLUSTER_NAME=testbed-v2
MONITORING_NS=monitoring

# ══════════════════════════════════════════════════════════════════════════════
# LANGFUSE — shared LLM tracing project (one project for all versions)
# ══════════════════════════════════════════════════════════════════════════════
# `make langfuse-provision` generates the keys below + the LANGFUSE_INIT_* seed values,
# then fans the keys into v2/v3/v4 .env. A fresh Langfuse (make langfuse-install, or
# docker compose --profile tracing) auto-creates this project on first start.
#
# Per-version cost: all versions push to this ONE project; each tags its traces with
# `version:vN` (set KI_VERSION in each vN/.env), so cost/tokens filter per version.
# (Separate per-version PROJECTS require a Langfuse Enterprise license — not OSS.)

LANGFUSE_ENABLED=true

# In-cluster default (Helm). For docker compose use http://localhost:3001.
LANGFUSE_HOST=http://langfuse-web.monitoring.svc.cluster.local:3000

# Populated by `make langfuse-provision` (pk-lf-... / sk-lf-...).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Headless-init seed values — Langfuse reads these on first boot to create the project.
LANGFUSE_INIT_ORG_ID=kubeintellect-org
LANGFUSE_INIT_ORG_NAME=KubeIntellect
LANGFUSE_INIT_PROJECT_ID=kubeintellect-project
LANGFUSE_INIT_PROJECT_NAME=KubeIntellect
LANGFUSE_INIT_USER_EMAIL=admin@kubeintellect.local
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=langfuse-admin
