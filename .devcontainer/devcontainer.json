{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "KubeIntellect (v4)",

  // Python 3.12 — the floor the project supports, and the version most CI jobs
  // use. CI also runs both suites on 3.13 (the runtime image's interpreter);
  // see .github/workflows/ci.yml.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/va-h/devcontainers-features/uv:1": {}
  },

  // Installs the whole v4 workspace so `uv run pytest` works immediately.
  "postCreateCommand": "bash scripts/dev-setup.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/v4/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.cwd": "${containerWorkspaceFolder}/v4",
        "ruff.configuration": "${containerWorkspaceFolder}/v4/pyproject.toml"
      }
    }
  },

  // A cluster is NOT required to contribute — the test suites are fully mocked.
  // Kind/Docker are only needed for the end-to-end paths in v4/docs/.
  "remoteUser": "vscode"
}
