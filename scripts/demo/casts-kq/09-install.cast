[17.589309, "o", "\r\n"]
[17.589365, "o", "\u001b[1;36m$ kubeintellect --version\u001b[0m\r\n"]
[17.621469, "o", "usage: kubeintellect [-h] {init,serve,db-init,status,set,service,kind-setup} ...\r\nkubeintellect: error: the following arguments are required: command\r\n"]
[17.625546, "o", "\r\n\u001b[1;36m$ kubeintellect init\u001b[0m\r\n"]
[18.681843, "o", "\u001b[1m\r\r\n  KubeIntellect — first-time setup\r\r\n\u001b[0m\r\r\n\u001b[2m  Found API keys in your environment — press Enter to use them.\r\r\n\u001b[0m\r\r\n"]
[18.682773, "o", "\r\r\n  \u001b[1mLLM Provider\u001b[0m\r\r\n    1  OpenAI        (api.openai.com)\r\r\n    2  Azure OpenAI  (your own Azure deployment)\r\r\n\r\r\n  Choose [1/2] [1]: "]
[19.94576, "o", "1"]
[19.946478, "o", "\r\r\n\r\r\n  OPENAI_API_KEY: [\u001b[2msk-d***0000\u001b[0m]\r\r\n    \u001b[2m→  platform.openai.com → API keys\u001b[0m\r\r\n  > "]
[21.153049, "o", "\r\r\n"]
[21.153764, "o", "\u001b[33m\r\r\n  No Kubernetes cluster found (~/.kube/config missing).\u001b[0m\r\r\n  Create a local Kind cluster with sample workloads? [Y/n]: "]
[22.41628, "o", "n"]
[22.416896, "o", "\r\r\n"]
[22.417482, "o", "\r\r\n  \u001b[32m✓\u001b[0m  kubeintellect  /tmp/kubeintellect-demo-home/.kubeintellect/.env\r\r\n  \u001b[32m✓\u001b[0m  kube-q         /tmp/kubeintellect-demo-home/.kube-q/.env\r\r\n  \u001b[32m✓\u001b[0m  Access level:  \u001b[31madmin  (full access)\u001b[0m\r\r\n  \u001b[32m✓\u001b[0m  API key:       \u001b[1mki-admin-9b73a00cc243d6730590\u001b[0m\r\r\n\u001b[33m\r\r\n  Issues detected in the saved configuration:\r\r\n\u001b[0m\r\r\n\u001b[33m   [warn]\u001b[0m  \u001b[1mKUBECONFIG_PATH\u001b[0m: Kubeconfig not found at /tmp/kubeintellect-demo-home/.kube/config\r\r\n           \u001b[2mIf you don't have a cluster yet:\u001b[0m\r\r\n           \u001b[2m         kubeintellect kind-setup       # creates a local Kind cluster\u001b[0m\r\r\n           \u001b[2m         kubectl config view --minify   # verify your current context\u001b[0m\r\r\n\r\r\n\u001b[2m  Edit /tmp/kubeintellect-demo-home/.kubeintellect/.env or re-run 'kubeintellect init' to fix them.\r\r\n\u001b[0m\r\r\n\r\r\n  \u001b[1m── Setup complete ───────────────────────────────────────────────────────\u001b[0m\r\r\n  API key:     \u001b[1mki-admin-9b73a00cc243d6730590\u001b[0m\r\r\n  Config file: /tmp/kubeintellect-demo-home/.kubeintellect/.env\r\r\n  \u001b[1m─────────────────────────────────────────────────────────────────────────\u001b[0m\r\r\n\r\r\n"]
[22.473493, "o", "\u001b[33m\r\r\n  Postgres is not running.\u001b[0m\r\r\n  Options:\r\r\n    1  Use SQLite  (default — no setup needed, good for testing)\r\r\n    2  Start a postgres container via Docker\r\r\n"]
[22.474349, "o", "  Choose [1/2] (default: 1): "]
[23.737019, "o", "1\r\r\n"]
[23.737901, "o", "\u001b[32m  ✓  SQLite mode enabled.\u001b[0m Data stored at ~/.kubeintellect/kubeintellect.db\r\r\n\r\r\n"]
[23.741073, "o", "  Install as background service? (server starts automatically on login) [Y/n]: "]
[25.00282, "o", "n\r\r\n"]
[25.003647, "o", "  Start server and open kq now? [Y/n]: "]
[26.280392, "o", "n\r\r\n"]
