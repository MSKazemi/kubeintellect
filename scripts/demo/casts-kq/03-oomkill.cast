[19.448706, "o", "\r\u001b[2K\u001b[2;36m╭─\u001b[0m\u001b[2;36m──────────────────────────────────────\u001b[0m\u001b[2;36m \u001b[0m\u001b[1;2;36mInvestigation Plan\u001b[0m\u001b[2;36m \u001b[0m\u001b[2;36m──────────────────────────────────────\u001b[0m\u001b[2;36m─╮\u001b[0m\r\r\n\u001b[2;36m│\u001b[0m   \u001b[32m✓\u001b[0m \u001b[36m1.\u001b[0m Describe the `report-worker` pod to confirm memory limits and termination details.        \u001b[2;36m│\u001b[0m\r\r\n\u001b[2;36m│\u001b[0m   \u001b[32m✓\u001b[0m \u001b[36m2.\u001b[0m Query Prometheus for memory usage metrics of the `report-worker` pod over the last 30     \u001b[2;36m│\u001b[0m\r\r\n\u001b[2;36m│\u001b[0m minutes.                                                                                         \u001b[2;36m│\u001b[0m\r\r\n\u001b[2;36m│\u001b[0m   \u001b[32m✓\u001b[0m \u001b[36m3.\u001b[0m Fetch logs from the previous container instance of the `report-worker` pod.               \u001b[2;36m│\u001b[0m\r\r\n\u001b[2;36m╰──────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\r\nThe \u001b[1;36;40mreport-worker\u001b[0m pod in the \u001b[1;36;40mshop\u001b[0m namespace                                                         "]
[19.542758, "o", "\r\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[2;36m╭─\u001b[0m\u001b[2;36m──────────────────────────────────────\u001b[0m\u001b[2;36m \u001b[0m\u001b[1;2;36mInvestigation Plan\u001b[0m\u001b[2;36m \u001b[0m\u001b[2;36m──────────────────────────────────────\u001b[0m\u001b[2;36m─╮\u001b[0m\r\r\n\u001b[2;36m│\u001b[0m   \u001b[32m✓\u001b[0m \u001b[36m1.\u001b[0m Describe the `report-worker` pod to confirm memory limits and termination details.        \u001b[2;36m│\u001b[0m\r\r\n\u001b[2;36m│\u001b[0m   \u001b[32m✓\u001b[0m \u001b[36m2.\u001b[0m Query Prometheus for memory usage metrics of the `report-worker` pod over the last 30     \u001b[2;36m│\u001b[0m\r\r\n\u001b[2;36m│\u001b[0m minutes.                                                                                         \u001b[2;36m│\u001b[0m\r\r\n\u001b[2;36m│\u001b[0m   \u001b[32m✓\u001b[0m \u001b[36m3.\u001b[0m Fetch logs from the previous container instance of the `report-worker` pod.               \u001b[2;36m│\u001b[0m\r\r\n\u001b[2;36m╰──────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\r\nThe \u001b[1;36;40mreport-worker\u001b[0m pod in the \u001b[1;36;40mshop\u001b[0m namespace is repeatedly being killed due to exceeding its memory  \r\r\nlimit (\u001b[1;36;40mOOMKilled\u001b[0m). Here are the findings:                                                           \r\r\n\r\r\n\u001b[1;35mPod Description\u001b[0m                                                                                     \r\r\n\r\r\n\u001b[1m • \u001b[0m\u001b[1mImage\u001b[0m: \u001b[1;36;40mbusybox:1.37\u001b[0m                                                                              \r\r\n\u001b[1m • \u001b[0m\u001b[1mCommand\u001b[0m:                                                                                         \r\r\n\u001b[1m   \u001b[0m\u001b[48;2;39;40;34m  